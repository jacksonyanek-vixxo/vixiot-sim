    "spike": { "enabled": true, "rate_per_hour": 1200, "severity": 1.0 },
    "drift": { "enabled": true, "rate_per_hour": 1200, "severity": 1.0 },
    "stuck": { "enabled": true, "rate_per_hour": 600, "severity": 1.0 },
    "dropout": { "enabled": true, "rate_per_hour": 600, "severity": 1.0 },
